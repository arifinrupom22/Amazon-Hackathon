# ---------------------------------------------------------------------------
# HomePilot AI — environment template
# Copy to `.env` and adjust. Never commit a real .env file.
# DATABASE_URL is required by the server. AI provider settings are optional.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# HTTP port for the API + MCP endpoint (the web dev server proxies to this).
PORT=8787
HOST=127.0.0.1

# Comma-separated list of allowed browser origins (CORS + Origin validation).
# The Vite dev server origin is the default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string (Neon, local PostgreSQL, or Docker).
# Keep this server-side. Never prefix it with VITE_.
DATABASE_URL=postgresql://user:password@localhost:5432/homepilot

# --- AI provider ------------------------------------------------------------
# Which provider turns natural language into a structured, reviewable plan.
#   google             -> Google AI Studio / Gemini API (Gemma 4). Set GEMINI_API_KEY first.
#   openai-compatible  -> any OpenAI-compatible /chat/completions endpoint
#   demo               -> deterministic local planner only (no model, no network)
#                         also the automatic fallback when a live provider fails.
# Google AI Studio is the selected provider for this project.
AI_PROVIDER=google

# --- Google AI Studio (Gemma 4) ---------------------------------------------
# Create a free key at https://aistudio.google.com/apikey and put it in .env only.
GEMINI_API_KEY=
# Gemma 4 models hosted by the Gemini API: gemma-4-26b-a4b-it (4B active params)
# and gemma-4-31b-it. Set the exact id shown in AI Studio if it differs.
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional server-side speech transcription ------------------------------
# Independent of AI_PROVIDER. Requires GEMINI_API_KEY above. When configured,
# the AI Assistant can offer "Google transcription" as an explicit alternative
# to the browser's Web Speech API (useful when that service is blocked).
# Audio is uploaded only when the user presses the mic, is not stored by the app,
# and the temporary Google file is deleted after transcription.
GOOGLE_TRANSCRIPTION_ENABLED=true
GOOGLE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# --- OpenAI-compatible endpoint ---------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Required by most hosted endpoints. Put the real key in .env — never commit it.
OPENAI_API_KEY=

# --- Web --------------------------------------------------------------------
# Base URL the browser uses to reach the API + MCP endpoint.
# In dev this is proxied by Vite, so leave it empty.
VITE_API_BASE=
